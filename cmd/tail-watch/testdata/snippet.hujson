// Policy additions TestLiveTailnetDocker needs to run with its default
// TAIL_WATCH_LIVE_TAG=tag:monitor. Merge these keys into the lab tailnet policy
// (tailscale-utils-lab: lab/policy/lab.acl.hujson); they are not applied
// from here.
{
	"tagOwners": {
		"tag:monitor": ["autogroup:admin"],
	},
	"grants": [
		// The peer the test discovers is a member device. The grant also puts
		// it in the collector's netmap, which is all tsping (disco) needs.
		// TestLiveNotifications also probes its fixture nodes with icmp, tcp:9000
		// (the tcp check) and tcp:8080 (the http check).
		{
			"src": ["tag:monitor"],
			"dst": ["autogroup:member"],
			"ip":  ["icmp:*", "tcp:22", "tcp:8080", "tcp:9000"],
		},
		// Subnet targets, including the test router's 10.10.50.1.
		{
			"src": ["tag:monitor"],
			"dst": ["10.10.0.0/16"],
			"ip":  ["icmp:*"],
		},
	],
}
