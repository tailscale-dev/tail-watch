// Policy additions TestLiveTailnetDocker needs to run with its default
// TAIL_WATCH_LIVE_TAG=tag:monitor. Merge these keys into the lab tailnet policy
// (tailscale-utils-lab: lab/policy/lab.acl.hujson); they are not applied
// from here.
{
	"tagOwners": {
		"tag:monitor": ["autogroup:admin"],
		// The setec server TestLiveSetec runs as a tsnet node.
		"tag:secrets": ["autogroup:admin"],
		// The Kubernetes operator and the ProxyGroup devices it creates, for
		// TestKindProxyGroup.
		"tag:k8s-operator": ["autogroup:admin"],
		"tag:k8s": ["tag:k8s-operator"],
	},
	"autoApprovers": {
		// Let the operator's ProxyGroups advertise Tailscale Services without a
		// manual approval per Service.
		"services": {
			"svc:*": ["tag:k8s"],
		},
	},
	"grants": [
		// The peer the test discovers is a member device. The grant also puts
		// it in the collector's netmap, which is all tsping (disco) needs.
		// TestLiveNotifications also probes its fixture nodes with icmp, tcp:9000
		// (the tcp check) and tcp:8080 (the http check).
		{
			"src": ["tag:monitor"],
			"dst": ["autogroup:member"],
			"ip":  ["icmp:*", "tcp:22", "tcp:8080", "tcp:9000"],
		},
		// TestLiveSetec: the collector reaches the setec server, and may get, put
		// and activate under live/ only. The test seeds and rotates its own
		// secrets from the collector's node, so put and activate are granted.
		{
			"src": ["tag:monitor"],
			"dst": ["tag:secrets"],
			"ip":  ["*"],
		},
		{
			"src": ["tag:monitor"],
			"dst": ["tag:secrets"],
			"app": {
				"tailscale.com/cap/secrets": [
					{
						"action": ["get", "info", "put", "activate"],
						"secret": ["live/*"],
					},
				],
			},
		},
		// Subnet targets, including the test router's 10.10.50.1.
		{
			"src": ["tag:monitor"],
			"dst": ["10.10.0.0/16"],
			"ip":  ["icmp:*"],
		},
	],
}
