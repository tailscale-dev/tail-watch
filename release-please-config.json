{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "go",
      "include-component-in-tag": false,
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": false,
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        "examples/kubernetes/sidecar.yaml",
        "examples/kubernetes/kyverno-clusterpolicy.yaml",
        "examples/kubernetes/mutatingadmissionpolicy.yaml",
        "examples/kubernetes/freeze-and-patch.sh",
        "docs/how-to/kubernetes-proxygroup.md"
      ],
      "draft": false,
      "prerelease": false,
      "changelog-sections": [
        { "type": "feat", "section": "Added", "hidden": false },
        { "type": "fix", "section": "Fixed", "hidden": false },
        { "type": "perf", "section": "Performance", "hidden": false },
        { "type": "revert", "section": "Reverts", "hidden": false },
        { "type": "docs", "section": "Documentation", "hidden": false },
        { "type": "refactor", "section": "Changed", "hidden": true },
        { "type": "style", "section": "Style", "hidden": true },
        { "type": "test", "section": "Tests", "hidden": true },
        { "type": "build", "section": "Build & CI", "hidden": true },
        { "type": "ci", "section": "Build & CI", "hidden": true },
        { "type": "chore", "section": "Chores", "hidden": true }
      ]
    }
  }
}
